# Shiori — Configuration Supabase (optionnelle pour le mode local, requise pour la sync cloud)
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon-publique

# Optionnel : URL du site pour les redirections OAuth
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shiori — Synchronisation bidirectionnelle AniList OAuth 2.0 (ne jamais partager le secret)
ANILIST_CLIENT_ID=votre-client-id-anilist
ANILIST_CLIENT_SECRET=votre-client-secret-anilist
NEXT_PUBLIC_ANILIST_REDIRECT_URI=http://localhost:3000/auth/anilist/callback

# Shiori — Mini-assistant IA de recommandation (Google Gemini via @google/generative-ai)
GEMINI_API_KEY=votre-cle-api-gemini

# Shiori — Rôle Créateur / Administration (vérifié uniquement côté serveur)
ADMIN_EMAIL=votre-email-createur@exemple.com
ADMIN_ANILIST_ID=123456
# Optionnel : clé Service Role Supabase pour administration complète côté serveur
# SUPABASE_SERVICE_ROLE_KEY=votre-cle-service-role

# Shiori — Lien de soutien / don affiché sur /support (Ko-fi, Buy Me a Coffee ou PayPal.me)
NEXT_PUBLIC_DONATION_URL=https://ko-fi.com/votre-compte
